# PostgreSQL
POSTGRES_USER=facesuc
POSTGRES_PASSWORD=facesuc_dev_password
POSTGRES_DB=facesuc
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_2026
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*

# Usuario administrador inicial (se crea/actualiza al iniciar el backend)
ADMIN_CEDULA=12345678
ADMIN_PASSWORD=Cambiar123!
ADMIN_NOMBRE=Prof. Administradora FACES

# Importación automática del CSV al arrancar (true/false)
IMPORT_CSV_ON_START=false
CSV_PATH=/app/data/baseDeDatosSistemaConstancia.csv

# Frontend
FRONTEND_PORT=5173
