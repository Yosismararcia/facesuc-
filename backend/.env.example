# Para desarrollo local del backend (sin Docker)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://facesuc:facesuc_dev_password@localhost:5432/facesuc?schema=public
# JWT_SECRET: Cambiar por un valor fuerte y aleatorio de al menos 32 caracteres en producción.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_2026_minimo_32_caracteres
