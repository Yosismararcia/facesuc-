# CORS_ORIGIN: En producción poner el dominio real, separado por comas si es necesario.
CORS_ORIGIN=http://localhost:5173
TEMPLATE_PATH=./templates/Notas.docx
ADMIN_CEDULA=12345678
ADMIN_PASSWORD=Cambiar123!
